---
import DiffTable from './DiffTable.astro';

interface Props {
  variant: 'home' | 'photo';
  dropLabel: string;
  capture?: boolean;
  accept: string;
  resultTitle: string;
}

const { variant, dropLabel, capture = false, accept, resultTitle } = Astro.props;
---

<section
  class="tool-bench"
  data-tool-bench
  data-variant={variant}
  data-result-title={resultTitle}
>
  <div class="tool-grid">
    <div class="tool-input">
      <div
        class="drop-zone"
        data-drop-zone
        role="button"
        tabindex="0"
        aria-label={`${dropLabel} JPEG, PNG, WebP or HEIC, up to 100MB. ${variant === 'photo' ? 'Take a photo Choose from Photos' : 'Choose a file'}`}
      >
        <svg class="drop-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          {variant === 'photo' ? (
            <>
              <rect x="3" y="6" width="18" height="14" rx="3" />
              <circle cx="12" cy="13" r="3.5" />
              <path d="M8 6l1.5-2.5h5L16 6" />
            </>
          ) : (
            <>
              <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
              <path d="M14 3v5h5M12 12v6m-3-3 3 3 3-3" />
            </>
          )}
        </svg>
        <p id={`${variant}-drop-label`}>{dropLabel}</p>
        <p class="drop-hint" id={`${variant}-drop-hint`}>JPEG, PNG, WebP or HEIC, up to 100MB.</p>
        <div class="drop-actions" id={`${variant}-drop-actions`}>
          {variant === 'photo' && (
            <button type="button" class="btn btn-primary" data-choose>Take a photo</button>
          )}
          <button type="button" class="btn" data-choose>
            {variant === 'photo' ? 'Choose from Photos' : 'Choose a file'}
          </button>
        </div>
      </div>
      <input
        type="file"
        data-file-input
        accept={accept}
        capture={capture && variant === 'photo' ? 'environment' : undefined}
        aria-label={variant === 'photo' ? 'Choose a photo file' : 'Choose a file'}
        class="visually-hidden"
      />
      <p class="file-summary" data-file-summary hidden></p>
      <p data-size-warning hidden>
        This file is over 50MB. It may take a while on a phone; a desktop browser will handle it faster.
      </p>
      <p aria-live="polite" data-status></p>
    </div>
    <div class="tool-result">
      <p class="result-empty" data-result-empty>
        Choose a file to see what was removed, then download the cleaned file and its report.
      </p>
      <div class="result-banner" data-result-banner hidden>
        <span data-result-icon aria-hidden="true"></span>
        <div>
          <p><strong data-result-state></strong></p>
          <p data-result-detail></p>
        </div>
      </div>
      <DiffTable />
      <div class="btn-row" data-download-area hidden>
        <button type="button" class="btn btn-primary" data-download-cleaned>Download cleaned file</button>
        <button type="button" class="btn" data-download-report-html>Download report</button>
        <button type="button" class="btn btn-tertiary" data-download-report-json>Download report JSON</button>
      </div>
      <p data-failure hidden>
        We couldn't process this file. <button type="button" class="btn" data-retry>Try a different file</button>
      </p>
    </div>
  </div>
</section>

<script>
  import { mountToolBench } from './uploader';
  document.querySelectorAll<HTMLElement>('[data-tool-bench]').forEach((root) => {
    mountToolBench(root);
  });
</script>
